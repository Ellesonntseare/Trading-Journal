# EDGE AI uses Groq. Never put this key in public/frontend code.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Accounts
# Optional: people must type this code to create an account
INVITE_CODE=
# Set to false to stop new sign-ups (the first account is always allowed)
ALLOW_SIGNUP=true
# Set to 1 only when running behind Caddy/https (see deploy folder)
TRUST_PROXY=0
